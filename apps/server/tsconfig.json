{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@kb/config/tsconfig/node.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["node"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
