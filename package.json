{
    "name": "enterprise-kb",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.10.1",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write \"apps/**/*\" \"packages/**/*\" \"*.{js,json}\" \".vscode/*.json\" \".github/**/*.{yml,yaml}\"",
        "format:check": "prettier --check \"apps/**/*\" \"packages/**/*\" \"*.{js,json}\" \".vscode/*.json\" \".github/**/*.{yml,yaml}\"",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue}": [
            "eslint --config eslint.config.js --fix",
            "prettier --write"
        ],
        "*.{json,md,html,css,scss,yml,yaml}": "prettier --write"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@kb/config": "workspace:*",
        "eslint": "^10.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.9",
        "typescript": "^7.0.2"
    }
}
