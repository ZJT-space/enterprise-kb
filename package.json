{
    "name": "enterprise-kb",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.10.1",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write \"apps/**/*\" \"packages/**/*\" \"*.{js,json}\" \".vscode/*.json\"",
